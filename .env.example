# ---------------------------------------------------------------------------
# Coreflow — environment configuration
#
#   cp .env.example .env
#
# Every value below has a working default for local development. The stack boots
# and is fully usable with demo data WITHOUT filling in a single credential —
# both integrations ship disabled on purpose.
#
# NEVER commit .env. It is gitignored; keep it that way.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development

# Leave APP_URL/API_URL EMPTY for local development: docker-compose derives them
# from FRONTEND_PORT/BACKEND_PORT below, so changing a port (because something
# already occupies 3000/8000 on your machine) keeps everything consistent —
# including the URL the browser calls and the CSRF/CORS allowlists.
# Set them explicitly only behind a reverse proxy or a real domain.
APP_URL=
API_URL=

# Django settings module: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true

# REQUIRED IN PRODUCTION. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# prod.py refuses to boot with an empty, short, or obviously-insecure key.
SECRET_KEY=

# Comma-separated. Production must list explicit hostnames; "*" is rejected.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Timestamps are stored in UTC; this affects display and report day/month boundaries.
TIME_ZONE=Europe/Berlin

# Move the admin off the default path in production. Must end with a slash.
ADMIN_URL=admin/

LOG_LEVEL=INFO
# LOG_LEVEL_INTEGRATIONS=DEBUG   # verbose provider HTTP logging (credentials are always scrubbed)

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://coreflow:coreflow@postgres:5432/coreflow

# Used by the postgres container itself.
POSTGRES_USER=coreflow
POSTGRES_PASSWORD=coreflow
POSTGRES_DB=coreflow
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Ports (host side)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Lexware Office
#
# Leave LEXWARE_ENABLED=false to run without Lexware. Nothing calls the API when
# it is false. See docs/integrations/lexware.md for setup.
# ---------------------------------------------------------------------------
LEXWARE_ENABLED=false
LEXWARE_API_BASE_URL=https://api.lexware.io

# From https://app.lexware.de/addons/public-api — server-side only, never exposed
# to the browser. NOTE: deleting/regenerating a key DELETES all its webhook
# subscriptions; re-register them afterwards in the integration centre.
LEXWARE_API_KEY=

# Public HTTPS base URL Lexware can reach for webhooks (e.g. an ngrok/Cloudflare
# tunnel in dev). Lexware validates it with a HEAD request and requires HTTPS.
LEXWARE_WEBHOOK_PUBLIC_URL=

# Unguessable path segment for the webhook URL. Defence in depth alongside the
# RSA-SHA512 signature check. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LEXWARE_WEBHOOK_SECRET=

LEXWARE_SYNC_INTERVAL_MINUTES=30

# KEEP FALSE unless you know exactly what you are doing.
# false → invoices are created as DRAFTS in Lexware for human review (recommended).
# true  → invoices are created FINALISED: a legally binding document with a real
#         invoice number, issued immediately and with no review step. Lexware
#         does not allow finalising a draft via the API afterwards, so this flag
#         is the ONLY moment the decision can be made.
LEXWARE_CREATE_FINAL_INVOICES=false

# ---------------------------------------------------------------------------
# Clockify (optional)
#
# Coreflow's own time tracking is fully functional with this disabled.
# See docs/integrations/clockify.md.
# ---------------------------------------------------------------------------
CLOCKIFY_ENABLED=false
CLOCKIFY_API_BASE_URL=https://api.clockify.me/api/v1

# Personal API key: Clockify → Profile settings → "Manage API keys".
# Auth is this single key (X-Api-Key header); the rights of its user apply.
CLOCKIFY_API_KEY=

# Optional: pin the Clockify workspace to sync. Empty = the key's active
# workspace is resolved automatically on the first call.
CLOCKIFY_WORKSPACE_ID=

# Signing tokens of the webhooks created in the Clockify UI (workspace
# settings → Webhooks). Clockify subscribes ONE event type per webhook, so
# create one webhook per event (NEW_TIME_ENTRY, TIME_ENTRY_UPDATED,
# TIME_ENTRY_DELETED, TIMER_STOPPED, NEW_PROJECT, PROJECT_UPDATED,
# PROJECT_DELETED, NEW_CLIENT, CLIENT_UPDATED, CLIENT_DELETED, NEW_TAG,
# TAG_UPDATED, TAG_DELETED), all pointing at  <API_URL>/webhooks/clockify/  —
# and list every generated signing token here, comma-separated.
# Empty = inbound webhooks off; the periodic sync below still runs.
CLOCKIFY_WEBHOOK_TOKEN=

CLOCKIFY_SYNC_INTERVAL_MINUTES=15

# Unlinked local entries younger than this are uploaded to Clockify (keeps a
# fresh connection from dump-loading years of history).
CLOCKIFY_PUSH_LOOKBACK_DAYS=30

# ---------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO in the dev stack)
#
# Leave OBJECT_STORAGE_ENDPOINT empty to fall back to local filesystem storage.
# ---------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=coreflow
OBJECT_STORAGE_SECRET_KEY=coreflow-dev-secret
OBJECT_STORAGE_BUCKET=coreflow
OBJECT_STORAGE_REGION=us-east-1

FILE_UPLOAD_MAX_BYTES=26214400

# ---------------------------------------------------------------------------
# Email (Mailpit in the dev stack; UI at http://localhost:8025)
# ---------------------------------------------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=coreflow@localhost

# ---------------------------------------------------------------------------
# Business defaults (overridable per workspace in Settings)
# ---------------------------------------------------------------------------
DEFAULT_CURRENCY=EUR
DEFAULT_HOURLY_RATE=95.00
DEFAULT_PAYMENT_TERM_DAYS=14

# Time-entry rounding. 0 = no rounding. Strategy: nearest | up | down
TIME_ROUNDING_INCREMENT_MINUTES=0
TIME_ROUNDING_STRATEGY=nearest

# ---------------------------------------------------------------------------
# Demo seed
# ---------------------------------------------------------------------------
DEMO_USER_EMAIL=demo@coreflow.local
DEMO_USER_PASSWORD=coreflow-demo-1234
